# Copy to /home/penultima/beats-monitor-api/.env on the production host.
# Generate the hash with:
# node -e "console.log(require('crypto').createHash('sha256').update(process.argv[1]).digest('hex'))" "your-password"

BEATS_MONITOR_HOST=127.0.0.1
BEATS_MONITOR_PORT=51842
BEATS_MONITOR_USER=admin
BEATS_MONITOR_PASSWORD_HASH=replace-with-sha256-password-hash
BEATS_MONITOR_TOKEN_SECRET=replace-with-at-least-32-random-characters
BEATS_MONITOR_TOKEN_TTL_SECONDS=3600

PENULTIMA_SERVER_ROOT=/home/penultima/Penultima-Server

# Keep false until mutating endpoints are explicitly audited and wired.
BEATS_MONITOR_ALLOW_MUTATIONS=false

# Same-origin proxy normally does not need CORS. Leave empty unless needed.
BEATS_MONITOR_ALLOWED_ORIGIN=
