# Copy to /home/penultima/beats-monitor-api/.env on the production host.
# Generate the hash with:
# node -e "console.log(require('crypto').createHash('sha256').update(process.argv[1]).digest('hex'))" "your-password"

BEATS_MONITOR_HOST=127.0.0.1
BEATS_MONITOR_PORT=51842
BEATS_MONITOR_USER=admin
BEATS_MONITOR_PASSWORD_HASH=replace-with-sha256-password-hash
BEATS_MONITOR_TOKEN_SECRET=replace-with-at-least-32-random-characters
BEATS_MONITOR_TOKEN_TTL_SECONDS=3600

# Optional: allow logging in with an existing game account instead of only the
# configured monitor user. The adapter verifies the account password in MySQL
# and requires the configured character to be a GOD/staff character.
BEATS_MONITOR_GAME_AUTH=true
BEATS_MONITOR_REQUIRED_PLAYER_NAME=Waldir
BEATS_MONITOR_MIN_GROUP_ID=6

PENULTIMA_SERVER_ROOT=/home/penultima/Penultima-Server

# Keep false until mutating endpoints are explicitly audited and wired.
BEATS_MONITOR_ALLOW_MUTATIONS=false
BEATS_MONITOR_ALLOW_CHAT_SEND=false
BEATS_MONITOR_REQUIRE_FRESH_GAME_BRIDGE=false

# Reads chat history/live updates from `beats_monitor_chat_messages`, which is
# filled by the local server chat scripts.
BEATS_MONITOR_CHAT_SOURCE=database
BEATS_MONITOR_CHAT_HISTORY_LIMIT=200
BEATS_MONITOR_CHAT_POLL_MS=2000

# Runtime log viewer. The API tails this file read-only and pushes updates over
# the existing authenticated WebSocket connection.
BEATS_MONITOR_LOG_ROOT=/home/penultima/Penultima-Server/logs
BEATS_MONITOR_RUNTIME_LOG_FILE=runtime.log
BEATS_MONITOR_LOG_TAIL_BYTES=262144
BEATS_MONITOR_LOG_HISTORY_LIMIT_LINES=1000
BEATS_MONITOR_LOG_POLL_MS=1000

# Same-origin proxy normally does not need CORS. Leave empty unless needed.
BEATS_MONITOR_ALLOWED_ORIGIN=
